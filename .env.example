# Copy to `backend/.env` for local development. Production reads the process
# environment instead -- never ship this file.

# --- Core -------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Email (Brevo SMTP) -----------------------------------------------------
BREVO_SMTP_LOGIN=your-brevo-login-email
BREVO_SMTP_KEY=your-brevo-smtp-api-key
DEFAULT_FROM_EMAIL=Bible Golf <noreply@biblegolf.app>
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=insecure-dev-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
# "console" for readable local logs, "json" for a log pipeline.
DJANGO_LOG_FORMAT=console

# --- Data -------------------------------------------------------------------
# SQLite locally; postgres://user:pass@host:5432/biblegolf in production.
# DATABASE_URL=postgres://biblegolf:biblegolf@localhost:5432/biblegolf
# DATABASE_REPLICA_URL=            # optional read replica
DB_CONN_MAX_AGE=60

# Optional locally (see USE_REDIS); required in production for the channel
# layer, which is what carries realtime frames between server processes.
REDIS_URL=redis://127.0.0.1:6379/0
USE_REDIS=false

# --- Auth -------------------------------------------------------------------
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30
# Defaults to DJANGO_SECRET_KEY; set separately to rotate one without the other.
# JWT_SIGNING_KEY=

# --- Client access ----------------------------------------------------------
# React Native sends no Origin, so this only matters for the Expo web build.
CORS_ALLOW_ALL_ORIGINS=true
# CORS_ALLOWED_ORIGINS=https://app.biblegolf.example
# CSRF_TRUSTED_ORIGINS=https://api.biblegolf.example

# Absolute base used to build URLs for uploaded card art.
PUBLIC_BASE_URL=http://localhost:8000
MEDIA_URL=/media/
MAX_CARD_ART_BYTES=5242880

# --- Game rules (must match src/constants/game.ts) --------------------------
GAME_TOTAL_HOLES=18
GAME_PAR_PER_HOLE=1
GAME_DIE_SIDES=6
# Seconds a player may sit on their turn before anyone can skip them.
GAME_TURN_TIMEOUT_SECONDS=90

# --- Rate limits (blank disables; dev leaves them off) ----------------------
# THROTTLE_AUTH=20/min
# THROTTLE_REGISTER=10/hour
# THROTTLE_JOIN=30/min
# THROTTLE_TURN=120/min
# THROTTLE_WRITE=60/min

# --- Observability (production) ---------------------------------------------
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.05
